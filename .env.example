# Copy to .env and adjust. .env is git-ignored and never committed.
# On the NAS, deploy/setup.sh creates this from the template for you.

# --- Compose stack definition ---
# The list of compose files that make up the stack. This lives HERE, not in the
# deploy scripts, and that is deliberate: .env is the one file that exists only
# on the NAS and is never overwritten by an update, so it cannot drift out of
# sync with the repo. The scripts pass no -f flags at all and read this instead.
#
# The alternative - each script naming the files itself - is what caused the
# 2026-09-01 incident: a stale update.sh still passing only -f prod.yml
# recreated the containers WITHOUT any share bind mounts. The stack came up
# healthy, both healthchecks passed, and nothing surfaced it until an rsync job
# failed with "not bind-mounted into the container". A script cannot get this
# wrong if it does not carry it.
#
# Separator is ":" on Linux. Order matters - later files merge over earlier.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.shares.yml

# --- GHCR image source (used by docker-compose.prod.yml) ---
# Your GitHub username/owner, lowercased. The CI workflow pushes images to
# ghcr.io/<owner>/nas-sync-manager-backend and -frontend.
IMAGE_OWNER=changeme
# Image tag to run on the NAS (latest = newest build from main).
IMAGE_TAG=latest

# --- Web ---
# Port the web UI is published on (http://<nas-ip>:WEB_PORT).
WEB_PORT=8088

# --- App ---
# Timezone for schedules and the container clock.
TZ=Europe/London

# --- Security ---
# Fernet key used to encrypt FTP passwords at rest. Leave BLANK to let the
# backend generate one on first run and persist it on the data volume
# (/data/app_secret.key). Set it only if you want to manage the key yourself.
APP_SECRET=
